# SUPERSCIENCE Web - Environment Variables

# Web Server Port
PORT=3000

# PostgreSQL Configuration
# Option A: Full Connection String (Recommended for Supabase, Neon, Railway, Render)
# DATABASE_URL=postgresql://postgres:yourpassword@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/superscience

# Option B: Individual Parameters (Used if DATABASE_URL is commented out)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=superscience
PGSSL=false

# Debug SQL Queries (set to true to log executed SQL in console)
DEBUG_SQL=false
